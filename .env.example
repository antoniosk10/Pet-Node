# App
NODE_ENV=development
API_PORT=3003
WEB_PORT=5173

# Postgres (docker-compose)
POSTGRES_USER=pulsedesk
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pulsedesk
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pulsedesk:change_me@localhost:5432/pulsedesk

# Redis (docker-compose)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Auth (нужны со Недели 3; заглушки уже здесь)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Frontend (Vite)
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000
